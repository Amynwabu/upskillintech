# Frontend Environment Variables
VITE_API_URL=http://localhost:3000

# Backend Environment Variables (used during build if needed)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Email Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=hello@upskillintech.com
# Legacy newsletter email configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_SENDER_EMAIL=hello@upskillintech.com
EMAIL_FROM_NAME=UpskillinTech
EMAIL_FROM_ADDRESS=hello@upskillintech.com
EMAIL_REPLY_TO=hello@upskillintech.com
WEBINAR_SUPPORT_EMAIL=hello@upskillintech.com
SITE_URL=http://localhost:3000
# Long random value used only to make abuse-prevention hashes non-portable.
WEBINAR_IP_HASH_SALT=replace_with_a_long_random_value
WEBINAR_EMAIL_BATCH_SIZE=25
# Optional operational contact; admin access still uses the existing authenticated admin role.
WEBINAR_ADMIN_EMAIL=
# Configure when SendGrid event webhooks are enabled.
EMAIL_WEBHOOK_SECRET=

# Integration tests are opt-in to prevent accidental production access.
RUN_DATABASE_INTEGRATION_TESTS=false
RUN_SENDGRID_INTEGRATION_TESTS=false

# Payments
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# GitHub Actions Secrets (set in repository settings, not in .env file)
# HOSTINGER_SERVER - Your Hostinger FTP/SFTP server address
# HOSTINGER_USERNAME - Your Hostinger FTP/SFTP username
# HOSTINGER_PASSWORD - Your Hostinger FTP/SFTP password
# VITE_API_URL - Production API URL
